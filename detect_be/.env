# ─── Database ───────────────────────────────────────────────
# Inside Docker (container-to-container): uses internal port 5432
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel123@localhost:5440/sentineldb
SYNC_DATABASE_URL=postgresql+psycopg2://sentinel:sentinel123@localhost:5440/sentineldb
# When running backend inside Docker compose, override with:
# DATABASE_URL=postgresql+asyncpg://sentinel:sentinel123@db:5432/sentineldb

# ─── JWT ────────────────────────────────────────────────────
SECRET_KEY=supersecretkey_change_in_production_32chars
REFRESH_SECRET_KEY=refreshsecretkey_change_in_production_32chars
